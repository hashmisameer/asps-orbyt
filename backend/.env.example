# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on
PORT=4000

# PostgreSQL connection
DATABASE_URL=postgres://orbyt:orbyt_password@localhost:5432/orbyt

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Company used when the login screen does not send one (single-company setup)
DEFAULT_COMPANY_CODE=ASPS

# First admin user created by `npm run seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe@123

# Frontend address allowed to call the API
CORS_ORIGIN=http://localhost:5173

# ORBYT owner (super admin) login for the Owner console at /owner, created by `npm run seed:owner`.
# Use a strong password (at least 10 characters). Keep it only with you.
OWNER_USERNAME=owner
OWNER_NAME=ORBYT owner
OWNER_PASSWORD=
